# Normalize line endings so the repository content is identical regardless of
# each developer's platform or core.autocrlf setting. Without this, Windows
# checkouts produce CRLF working files that conflict with the pre-commit
# `mixed-line-ending --fix=lf` hook.
* text=auto eol=lf

# Windows-native scripts must keep CRLF to run reliably.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never modify, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary

# Generated lockfiles: keep them out of diff review noise, but they ARE
# reviewed for dependency changes — see CONTRIBUTING.md.
package-lock.json linguist-generated=true
server/requirements.txt linguist-generated=true
