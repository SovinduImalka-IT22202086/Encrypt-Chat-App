# Encrypted Chat Application — example environment file
#
# Copy to `.env` locally. `.env` is git-ignored and MUST NEVER be committed.
# This file contains PLACEHOLDERS ONLY — no real credentials.
#
# Only variables for functionality that actually exists in the current phase
# are listed. Variables for authentication, databases, TLS, and cryptography
# will be added by the phases that implement them (Phase 3, 6, 10), not
# pre-created here.

# --- Application (Phase 1) -------------------------------------------------
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# --- Frontend (Phase 1) ----------------------------------------------------
# Vite exposes only variables prefixed with VITE_ to client code. Never place
# a secret behind a VITE_ prefix — it is bundled into the public build
# (see CLIENT-006 in docs/SECURITY_REQUIREMENTS.md).
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# NOT YET APPLICABLE — do not add real values, and do not implement the
# features these would configure, until the owning phase is authorized:
#
#   Phase 3 (authentication):  session/token signing key, Argon2id parameters
#   Phase 10 (deployment):     database URL, TLS certificate paths
#
# When those phases add variables here, they must remain placeholders such as
# `<replace-locally-never-commit>`. Real secrets are injected at deploy time
# via a secret manager (DEPLOY-002), never through a committed file.
# ---------------------------------------------------------------------------
